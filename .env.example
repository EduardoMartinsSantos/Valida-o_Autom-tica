# Connection string do banco da Nova Escala (mesmo DATABASE_URL do projeto nova-escala-mops).
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
# Chave para assinar a sessão. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres"
# Mesma SENHA_PADRAO da Nova Escala (login de quem ainda não trocou a senha).
